DATABASE_URL=postgresql://usuario:clave@host:5432/urbania360
JWT_SECRET=un-texto-largo-y-random
PORT=3000
# Opcional: si están las tres, al arrancar se crea (o actualiza) este usuario
SEED_ADMIN_NOMBRE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcional: datos de la empresa que salen en el presupuesto para el cliente
EMPRESA_TELEFONO=
EMPRESA_EMAIL=
EMPRESA_DIRECCION=
EMPRESA_CUIT=
EMPRESA_WEB=
# Envío del presupuesto por email (SMTP). Con Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=465, SMTP_USER=la cuenta, SMTP_PASS=una "contraseña de aplicación"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Opcional: dirección pública de la app para los links (si no, se toma de la visita)
APP_URL=

# Aviso por WhatsApp de solicitudes con urgencia ALTA
# Teléfono y nombre de quien recibe el aviso (ej.: Diego)
AVISO_URGENTE_TELEFONO=
AVISO_URGENTE_NOMBRE=
# Opcional: clave de CallMeBot (callmebot.com) para que el aviso se mande solo,
# sin tocar "Enviar". Sin la clave, la app abre WhatsApp con el mensaje listo.
AVISO_CALLMEBOT_APIKEY=

# Aviso cuando un cliente acepta o rechaza un presupuesto desde el link:
# llega a la campanita de la app y a los dispositivos donde se activaron los
# avisos (no requiere configuración). Si hay SMTP, también por email a:
AVISO_EMAIL=
# y por WhatsApp a AVISO_URGENTE_TELEFONO si está AVISO_CALLMEBOT_APIKEY.

# Avisos automáticos al GRUPO de WhatsApp de Urbania (Green-API, green-api.com):
# se vincula un número de WhatsApp escaneando un QR y la app escribe en el grupo
# (solicitudes urgentes y presupuestos aceptados o rechazados por el cliente).
WHATSAPP_GRUPO_INSTANCIA=
WHATSAPP_GRUPO_TOKEN=
WHATSAPP_GRUPO_ID=          # termina en @g.us (un admin lo ve en /api/whatsapp/grupos)
WHATSAPP_API_URL=           # opcional: la "API URL" que muestra Green-API
