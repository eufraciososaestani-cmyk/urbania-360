DATABASE_URL=postgresql://usuario:clave@host:5432/urbania360
JWT_SECRET=un-texto-largo-y-random
PORT=3000
# Opcional: si están las tres, al arrancar se crea (o actualiza) este usuario
SEED_ADMIN_NOMBRE=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcional: datos de la empresa que salen en el presupuesto para el cliente
EMPRESA_TELEFONO=
EMPRESA_EMAIL=
EMPRESA_DIRECCION=
EMPRESA_CUIT=
EMPRESA_WEB=
# Envío del presupuesto por email (SMTP). Con Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=465, SMTP_USER=la cuenta, SMTP_PASS=una "contraseña de aplicación"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Opcional: dirección pública de la app para los links (si no, se toma de la visita)
APP_URL=

# Aviso por WhatsApp de solicitudes con urgencia ALTA
# Teléfono y nombre de quien recibe el aviso (ej.: Diego)
AVISO_URGENTE_TELEFONO=
AVISO_URGENTE_NOMBRE=
# Opcional: clave de CallMeBot (callmebot.com) para que el aviso se mande solo,
# sin tocar "Enviar". Sin la clave, la app abre WhatsApp con el mensaje listo.
AVISO_CALLMEBOT_APIKEY=
